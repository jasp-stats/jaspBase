{
  "about": [
    "The term specifications of a FactorsForm: one list for jasp-desktop (which embeds this file at build time and builds",
    "the table of the term specification from it) and for jaspBase::prepareModelTerms() (which validates and reads them).",
    "name: the value of `specification` in the option. kind: continuous (a numeric variable), categorical (a coding of a",
    "nominal variable) or constant (no variable). default: offered by forms that do not list their own specifications (the",
    "name \"default\" in continuousSpecifications / categoricalSpecifications); the others need support of the analysis and",
    "are opt-in. title: the name in the table (the desktop translates the ones it knows). label: the term in the form,",
    "with {x} the variable, {parameter} its value, {parameter|paren} parenthesized unless a plain number,",
    "{parameter|signed} as ' + v' or ' - v', {parameter|choice} the short text of the choice, {parameter|number} the",
    "number written shortest, and [ ... ] left out while",
    "every parameter in it has its default (a reference level: the first level). parameters: name, type (number: a",
    "numeric expression, except the value of a constant offset, which is a plain number; integer; location: mean, median",
    "or a number; choice; level: a level of the factor), default,",
    "title, and min (integer), choices (choice) or placeholder.",
    "Adding a specification: an entry here, its builder in R/modelTerms.R (tests check that every entry has one and that",
    "its label fills in) and its tests; the desktop picks it up when it is rebuilt with this jaspBase. The desktop embeds",
    "this file as one C++ string literal, which MSVC limits to 16380 bytes."
  ],
  "specifications": [
    { "name": "none",           "kind": "continuous", "default": true,  "title": "Not transformed",                       "label": "{x}" },
    { "name": "center",         "kind": "continuous", "default": true,  "title": "Center: x − c",                    "label": "Center({x}[, {center}])",
      "parameters": [ { "name": "center", "type": "location", "default": "mean", "title": "At" } ] },
    { "name": "scale",          "kind": "continuous", "default": true,  "title": "Scale: (x − mean) / sd",           "label": "Scale({x})" },
    { "name": "log",            "kind": "continuous", "default": true,  "title": "Natural log: ln(x)",                    "label": "log({x})" },
    { "name": "logShift",       "kind": "continuous", "default": true,  "title": "Shifted log: ln(x + c)",                "label": "log({x}{shift|signed})",
      "parameters": [ { "name": "shift", "type": "number", "default": "1", "title": "c" } ] },
    { "name": "logBase",        "kind": "continuous", "default": true,  "title": "General log: c · log_b(x)",        "label": "[{logMultiplier}·]log({x}, base = {logBase})",
      "parameters": [ { "name": "logBase", "type": "number", "default": "10", "title": "Base" },
                      { "name": "logMultiplier", "type": "number", "default": "1", "title": "Multiplier" } ] },
    { "name": "reciprocal",     "kind": "continuous", "default": true,  "title": "Reciprocal: 1/x",                       "label": "1/{x}" },
    { "name": "power",          "kind": "continuous", "default": true,  "title": "Power: x^p",                            "label": "{x}^{exponent|paren}",
      "parameters": [ { "name": "exponent", "type": "number", "default": "2", "title": "Exponent" } ] },
    { "name": "root",           "kind": "continuous", "default": true,  "title": "Root: x^(1/d)",                         "label": "Root({x}, {rootDegree})",
      "parameters": [ { "name": "rootDegree", "type": "number", "default": "2", "title": "Degree" } ] },
    { "name": "boxCox",         "kind": "continuous", "default": true,  "title": "Box-Cox: (x^λ − 1) / λ", "label": "Box-Cox({x}, λ = {lambda})",
      "parameters": [ { "name": "lambda", "type": "number", "default": "0.5", "title": "λ" } ] },
    { "name": "yeoJohnson",     "kind": "continuous", "default": true,  "title": "Yeo-Johnson",                           "label": "Yeo-Johnson({x}, λ = {lambda})",
      "parameters": [ { "name": "lambda", "type": "number", "default": "0.5", "title": "λ" } ] },
    { "name": "asinh",          "kind": "continuous", "default": true,  "title": "Inverse hyperbolic sine: asinh(x)",     "label": "asinh({x})" },
    { "name": "logit",          "kind": "continuous", "default": true,  "title": "Logit: ln(x / (1 − x))",           "label": "logit({x})" },
    { "name": "probit",         "kind": "continuous", "default": true,  "title": "Probit: Φ⁻¹(x)",       "label": "probit({x})" },
    { "name": "arcsineSqrt",    "kind": "continuous", "default": true,  "title": "Arcsine square root: asin(√x)",    "label": "asin(sqrt({x}))" },
    { "name": "polynomial",     "kind": "continuous", "default": true,  "title": "Polynomial (orthogonal)",               "label": "Polynomial({x}, degree = {polynomialDegree})",
      "parameters": [ { "name": "polynomialDegree", "type": "integer", "default": "2", "min": 1, "title": "Degree" } ] },
    { "name": "rawPolynomial",  "kind": "continuous", "default": true,  "title": "Polynomial (raw): x, x², …",  "label": "Raw polynomial({x}, degree = {polynomialDegree})",
      "parameters": [ { "name": "polynomialDegree", "type": "integer", "default": "2", "min": 1, "title": "Degree" } ] },
    { "name": "naturalSpline",  "kind": "continuous", "default": true,  "title": "Natural cubic spline",                  "label": "Natural cubic spline({x}, df = {splineDf})",
      "parameters": [ { "name": "splineDf", "type": "integer", "default": "3", "min": 1, "title": "df" } ] },
    { "name": "bSpline",        "kind": "continuous", "default": true,  "title": "B-spline",                              "label": "B-spline({x}, df = {splineDf}, degree = {splineDegree})",
      "parameters": [ { "name": "splineDf", "type": "integer", "default": "4", "min": 1, "title": "df" },
                      { "name": "splineDegree", "type": "integer", "default": "3", "min": 1, "title": "Degree" } ] },
    { "name": "hinge",          "kind": "continuous", "default": true,  "title": "Hinge: max(x − k, 0)",             "label": "Hinge({x}, {knot})",
      "parameters": [ { "name": "knot", "type": "location", "default": "median", "title": "Knot" } ] },
    { "name": "threshold",      "kind": "continuous", "default": true,  "title": "Threshold: x > k",                      "label": "{x} > {cutoff}",
      "parameters": [ { "name": "cutoff", "type": "location", "default": "median", "title": "Cutoff" } ] },
    { "name": "binning",        "kind": "continuous", "default": true,  "title": "Bins (quantile groups)",                "label": "Bins({x}, {bins})",
      "parameters": [ { "name": "bins", "type": "integer", "default": "4", "min": 2, "title": "Bins" } ] },
    { "name": "fourier",        "kind": "continuous", "default": true,  "title": "Fourier: sin and cos of 2πx / P", "label": "Fourier({x}, period = {period}[, harmonics = {harmonics}])",
      "parameters": [ { "name": "period", "type": "number", "default": "12", "title": "Period" },
                      { "name": "harmonics", "type": "integer", "default": "1", "min": 1, "title": "Harmonics" } ] },
    { "name": "rank",           "kind": "continuous", "default": false, "title": "Rank",                                  "label": "rank({x})" },
    { "name": "normalScores",   "kind": "continuous", "default": false, "title": "Normal scores",                         "label": "Normal scores({x})" },
    { "name": "arrhenius",      "kind": "continuous", "default": false, "title": "Arrhenius: 1/(k_B T)",                  "label": "Arrhenius({x}, {temperatureUnit|choice})",
      "parameters": [ { "name": "temperatureUnit", "type": "choice", "default": "celsius", "title": "From",
                        "choices": [ { "value": "kelvin", "title": "Kelvin", "short": "K" },
                                     { "value": "celsius", "title": "Celsius", "short": "°C" },
                                     { "value": "fahrenheit", "title": "Fahrenheit", "short": "°F" } ] } ] },
    { "name": "offset",         "kind": "continuous", "default": false, "title": "Offset (coefficient 1)",                "label": "offset({x})" },

    { "name": "treatment",      "kind": "categorical", "default": true,  "title": "Treatment (dummy)",                    "label": "{x}[ (reference {referenceLevel})]",
      "parameters": [ { "name": "referenceLevel", "type": "level", "default": "", "title": "Reference" } ] },
    { "name": "simple",         "kind": "categorical", "default": true,  "title": "Simple (vs. reference, centered)",     "label": "{x} (simple[, reference {referenceLevel}])",
      "parameters": [ { "name": "referenceLevel", "type": "level", "default": "", "title": "Reference" } ] },
    { "name": "sum",            "kind": "categorical", "default": true,  "title": "Sum",                                  "label": "{x} (sum)" },
    { "name": "helmert",        "kind": "categorical", "default": true,  "title": "Helmert (vs. previous levels)",        "label": "{x} (Helmert)" },
    { "name": "reverseHelmert", "kind": "categorical", "default": true,  "title": "Reverse Helmert (vs. later levels)",   "label": "{x} (reverse Helmert)" },
    { "name": "successiveDifferences", "kind": "categorical", "default": true, "title": "Successive differences: b − a, c − b, …", "label": "{x} (successive differences)" },
    { "name": "forwardDifference", "kind": "categorical", "default": true, "title": "Forward differences: a − b, b − c, …", "label": "{x} (forward differences)" },
    { "name": "orthogonalPolynomial", "kind": "categorical", "default": true, "title": "Orthogonal polynomial",          "label": "{x} (polynomial)" },
    { "name": "sas",            "kind": "categorical", "default": true,  "title": "SAS",                                  "label": "{x} (SAS)" },
    { "name": "indicator",      "kind": "categorical", "default": false, "title": "Indicators (no intercept)",            "label": "{x} (indicators)" },

    { "name": "offsetConstant", "kind": "constant",    "default": false, "title": "Constant offset",                      "label": "offset({value|number})",
      "parameters": [ { "name": "value", "type": "number", "default": "", "title": "Value", "placeholder": "e.g. 2" } ] }
  ]
}
